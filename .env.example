# Local development settings. Copy to .env (which is gitignored — never commit it).
# Validated at startup by src/config/env.validation.ts.

# ---------- App ----------
NODE_ENV=development
APP_NAME=my-project
# Interface to listen on. 127.0.0.1 (default) only accepts local connections,
# e.g. from the api-gateway on the same host; use 0.0.0.0 in containers.
APP_HOST=127.0.0.1
PORT=3001
# fatal | error | warn | log | debug | verbose (default log)
LOG_LEVEL=log
API_PREFIX=
API_VERSION=
# Comma-separated list of allowed frontend origins, e.g. http://localhost:5173
CORS_ORIGINS=
CORS_CREDENTIALS=true

# ---------- Database ----------
# Also read by docker-compose.yaml, so the container and the app use the same credentials.
# The app runs on the host, so it reaches the Postgres container through localhost.
# (HOST is still accepted as a fallback for DATABASE_HOST.)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_DATABASE=my_project
# Connections per process. With the cluster runner the total is
# WORKERS x DATABASE_POOL_SIZE, which must stay below Postgres max_connections.
DATABASE_POOL_SIZE=10
# Keep false: the schema is managed by migrations (npm run migration:run).
# If true, the app creates tables on startup and migration:run then fails.
DATABASE_SYNCHRONIZE=false
DB_LOGGING=false
DATABASE_SSL=false
# Only set false for a server with a self-signed certificate: it disables
# certificate checks entirely.
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# ---------- Docs (Swagger) ----------
# Defaults to true, except when NODE_ENV=production (then false).
DOCS_ENABLED=true
DOCS_PATH=docs
DOCS_DESCRIPTION=

# ---------- JWT ----------
# Random secrets generated for this machine (at least 32 chars, and they must differ).
JWT_ACCESS_SECRET=g1fSccBv-oa-0ZDsaE3nxgS8Jlfqv27apqy9bi24zqjj5uRkL05IleGUicJ7V3XU
JWT_REFRESH_SECRET=CPvontII-WFNbao-mHcffnbQ6kVuatcWuMMSvqTw6oOZdIFJDqUgvGyX8Ns57ARR
JWT_ACCESS_TTL=15m
# Lifetime of a single refresh token (each refresh issues a new one).
JWT_REFRESH_TTL=7d
JWT_ISSUER=auth-service
JWT_AUDIENCE=auth-service-clients

# ---------- Refresh sessions ----------
# Absolute session lifetime from login; refreshing never extends it.
REFRESH_SESSION_MAX_DAYS=30
# How long the previous refresh token keeps working after a rotation
# (concurrent refreshes from several tabs). Older reuse revokes the session.
REFRESH_REUSE_GRACE_SECONDS=30
# Per-account login lockout: wrong passwords allowed per email per window
# (0 disables). Keyed by account, so users behind one NAT address don't lock
# each other out; the gateway adds a coarse per-IP limit on top.
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=900

# ---------- In-process caches (per worker; 0 disables) ----------
# Users loaded by the access-token check.
USER_CACHE_TTL_MS=5000
# GET /users/directory results.
DIRECTORY_CACHE_TTL_MS=30000

# ---------- Password hashing (argon2) ----------
# Concurrent hashes per process. Default: number of CPUs
# (the cluster runner divides the CPUs between workers).
# HASH_CONCURRENCY=
# Requests allowed to wait for a hashing slot before getting 503.
HASH_QUEUE_MAX=200

# ---------- Cluster runner (npm run start:cluster) ----------
# Worker processes. Default: number of CPUs.
# WORKERS=

# ---------- Seed (npm run seed:admin) ----------
# First administrator account. The password must meet the same policy as the
# API: 12+ characters with upper, lower, digit and special character.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator
